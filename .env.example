# Uberly — Vision IA (Gemini recommandé)
UBERLY_GEMINI_API_KEY=
# UBERLY_VISION_PROVIDER=mock

# Migration beta : supabase/uberly-beta.sql puis uberly-beta-v2.sql
UBERLY_BETA_MODE=true
# Requis côté serveur pour upload des screenshots :
# SUPABASE_SERVICE_ROLE_KEY=

# URL publique (OAuth Google + reset password)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog — analytics Uberly
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Margeo — OCR / Vision (optionnel, mock par défaut)
# MARGEO_VISION_PROVIDER=vision
# MARGEO_VISION_API_KEY=
# MARGEO_VISION_ENDPOINT=

NGROK_AUTHTOKEN=votre_token_ngrok

# Supabase — Project Settings → API
# Pour Maison (auth client) : préfixe NEXT_PUBLIC_ recommandé
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon
SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon

# Requis pour Maison (foyer + clé) — Settings → API → service_role
# Ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Optionnel — signature session cookie Maison (sinon dérivé de service_role)
# MAISON_SESSION_SECRET=une_chaine_secrete_longue

# IA locale — Qwen via Ollama (100 % local, aucune API cloud)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder
# OLLAMA_TIMEOUT_MS=120000

# Mode dev Maison — bypass connexion supermarché (local uniquement)
# MAISON_DEV_MODE=true
# Foyer dev pré-configuré : clé FAM-DEVMODE (bypass également la connexion courses)

# e.Leclerc Drive — connexion compte (OAuth partenaire ou redirection login)
# URL publique de l'app (callbacks OAuth) — requis en prod / ngrok
# MAISON_APP_URL=https://votre-domaine.ngrok-free.app
# MAISON_LECLERC_OAUTH_CLIENT_ID=
# MAISON_LECLERC_OAUTH_CLIENT_SECRET=
# MAISON_LECLERC_OAUTH_AUTHORIZE_URL=https://www.e.leclerc/auth
# MAISON_LECLERC_OAUTH_TOKEN_URL=
# MAISON_LECLERC_OAUTH_SCOPE=openid profile drive
# MAISON_LECLERC_OAUTH_RETURN_URL_PARAM=returnUrl

# Notion — base « Waitlist »
NOTION_TOKEN=ntn_votre_token
NOTION_WAITLIST_DATABASE_ID=35356780-a3d8-40f2-afdf-667543feb15a
NOTION_DIRECT_SYNC=true
